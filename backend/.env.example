# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/bookmyhall

# JWT
JWT_SECRET=bookmyhall_secret_key_12345

# Razorpay Payments (Set keys for live payments, else mocks will be active)
RAZORPAY_KEY_ID=rzp_test_mock_12345
RAZORPAY_KEY_SECRET=rzp_test_mock_secret_12345

# Cloudinary Media Storage (Optional: falls back to local disk storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email Settings (Optional: falls back to console log simulation if empty)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_NAME="BookMyHall Support"
FROM_EMAIL="support@bookmyhall.com"
